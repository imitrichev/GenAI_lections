# Настройка для работы с локальной моделью через Ollama или удаленной через OpenRouter

# Использовать ли локальную модель (true/false)
USE_LOCAL_MODEL=false

# Модель для OpenRouter (если USE_LOCAL_MODEL=false)
MODEL=tngtech/deepseek-r1t2-chimera

# URL для локальной модели (Ollama / LM Studio)
BASE_URL=http://localhost:11434

# Название модели в Ollama (если USE_LOCAL_MODEL=true)
OLLAMA_MODEL=qwen3:0.6b

# API ключ для OpenRouter (при необходимости)
OPENROUTER_API_KEY=your_api_key_here
